      "description": "Fast reviewer route from byte-verified canonical records to publication figures",
      "claim_scope": "verifies and renders frozen records; does not retrain models"
    },
    "full-claim": {
      "description": "Disclosed retrospective reconstruction of the accepted raw-data-to-U8 claim path",
      "claim_scope": "retrospective replay; never a new prospective validation"
    },
    "historical-replay": {
      "description": "Full claim path plus superseded and failed discovery-history branches",
      "claim_scope": "historical audit only"
    },
    "archival-continuation": {
